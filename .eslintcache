projects\\hardcore-frontend\\src\\actions\\abi\\NFTFundAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\UniswapV2PairAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\auth.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\LPGenesisPoolGame.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\NFTFund.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\vault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\App.test.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\App.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Footer\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Header\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Home\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\NFT\\index.jsx",["120"],"import React, { PureComponent } from 'react';\r\nimport { getEthAndHcoreBalance, sellHcore} from '../../actions';\r\nimport { connect } from 'react-redux';\r\nimport './style.scss'\r\n\r\nclass NFT extends PureComponent {\r\n    constructor() {\r\n        super()\r\n    }\r\n\r\n    componentDidMount() {\r\n        const { getEthAndHcoreBalance } = this.props;\r\n        getEthAndHcoreBalance()\r\n    }\r\n\r\n    render() {\r\n        const { liquidVault: {ethBalance, hCoreBalance} } = this.props;\r\n\r\n        return (\r\n            <main>\r\n                <section className='NFT-page'>\r\n                    <h1>NFT</h1>\r\n                        <button onClick={() => this.props.sellHcore()}>Sell Hcore</button>\r\n                    <div className='wrap-nft'>\r\n                        <div className='score'>Hcore: { parseFloat(hCoreBalance).toFixed(3)}</div>\r\n                        <div className='score'>ETH: { parseFloat(ethBalance).toFixed(3)}</div>\r\n                    </div>\r\n                </section>\r\n            </main>\r\n        )\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => {\r\n    return {\r\n        liquidVault: state.liquidVault\r\n    };\r\n};\r\n\r\nconst mapDispatchToProps = dispatch => {\r\n    return {\r\n        getEthAndHcoreBalance: (value) => {\r\n            dispatch(getEthAndHcoreBalance(value));\r\n        },\r\n        sellHcore: () => {\r\n            dispatch(sellHcore());\r\n        }\r\n    };\r\n};\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(NFT);","D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Vault\\index.jsx",["121","122","123"],"import React, { PureComponent } from 'react';\r\nimport { purchaseLP, claim, getLockedLP, stake, unStake } from '../../actions';\r\nimport Modal from '../../shared/Modal'\r\nimport { connect } from 'react-redux';\r\nimport './style.scss'\r\n\r\nclass Vault extends PureComponent {\r\n    constructor() {\r\n        super()\r\n        this.state = {\r\n            modalIsOpen: false,\r\n            inputEth: '',\r\n            modalType: ''\r\n        }\r\n\r\n        this.changeModalStatus = this.changeModalStatus.bind(this)\r\n        this.changeInput = this.changeInput.bind(this)\r\n        this.sendEth = this.sendEth.bind(this)\r\n        this.stakeLp = this.stakeLp.bind(this)\r\n    }\r\n\r\n    componentDidMount() {\r\n        const { getLockedLP } = this.props;\r\n        getLockedLP()\r\n    }\r\n\r\n    sendEth() {\r\n        const { purchaseLP, liquidVault } = this.props;\r\n        const { inputEth } = this.state;\r\n        this.setState({ modalIsOpen: false })\r\n        purchaseLP(inputEth, liquidVault.balance);\r\n    }\r\n\r\n    stakeLp() {\r\n        const { stake } = this.props;\r\n        const { inputEth } = this.state;\r\n        this.setState({ modalIsOpen: false })\r\n        stake(inputEth);\r\n    }\r\n\r\n    changeInput(e) {\r\n        this.setState({ inputEth: e.target.value });\r\n    }\r\n\r\n    changeModalStatus(type) {\r\n        let { modalIsOpen } = this.state;\r\n        this.setState({ modalIsOpen: !modalIsOpen, inputEth: '', modalType: type })\r\n    }\r\n\r\n    renderModalBody() {\r\n        const { inputEth, modalType } = this.state;\r\n        const { liquidVault } = this.props\r\n        if (modalType !== 'send') {\r\n            return (\r\n                <div className='wrap-modal'>\r\n                    <div className='title'>Enter Value</div>\r\n                    <input type='number' value={inputEth} onChange={this.changeInput}></input>\r\n                    <div>{`LP balance: ${liquidVault.myLpTokens}`}</div>\r\n                </div>\r\n            )\r\n        }\r\n        return (\r\n            <div className='wrap-modal'>\r\n                <div className='title'>Enter Value</div>\r\n                <input type='number' value={inputEth} onChange={this.changeInput}></input>\r\n                <div>{`Amount to send: ${parseFloat(inputEth - inputEth / 100 * liquidVault.purchaseFee).toFixed(4)}`}</div>\r\n                <div>{`ETH fee: ${(inputEth / 100 * liquidVault.purchaseFee).toFixed(2)}`}</div>\r\n            </div>\r\n        )\r\n    }\r\n\r\n    render() {\r\n        const { claim, liquidVault, unStake } = this.props;\r\n        const { modalIsOpen, modalType, inputEth } = this.state;\r\n        return (\r\n            <React.Fragment>\r\n                <section className='vault'>\r\n                    <div className='vault-page-title'>Vault</div>\r\n                    <div className='stake-panel'>\r\n                        <div className='header-panel'>\r\n                            <div className='header-text'>\r\n                                Send ETH. It is pooled with $HCORE. Your discounted LP is locked for a period. \r\n                            </div>\r\n                            <div>\r\n                                <div className='wrap-title second'>\r\n                                    <div className='header-text'>Available $HCORE</div>\r\n                                    <div className='stake-value'>0000000</div>\r\n                                </div>\r\n                            </div>\r\n                            </div>\r\n                        <div className='stake'>\r\n                            <div className='stake-header'>\r\n                                <div className='wrap-title first'>\r\n                                    <div className='stake-title'>Max ETH</div>\r\n                                    <div className='stake-value'>00000000</div>\r\n                                </div>\r\n                                <div className='wrap-title first'>\r\n                                    <div className='stake-title'>Lock Period</div>\r\n                                    <div className='stake-value'>00000000</div>\r\n                                </div>\r\n                                <div className='wrap-title first'>\r\n                                    <div className='stake-title'>LP Discount</div>\r\n                                    <div className='stake-value'>00000000</div>\r\n                                </div>\r\n                                <div className='wrap-title first'>\r\n                                    <div className='stake-title'>LP Burn</div>\r\n                                    <div className='stake-value'>00000000</div>\r\n                                </div>\r\n                                <div className='second-block'>\r\n                                <div className='wrap-title second'>\r\n                                    <div className='stake-title'>Not yet claimable LP</div>\r\n                                    <div className='stake-value'>00000000</div>\r\n                                </div>\r\n                                    <div className='wrap-title second'>\r\n                                        <div className='stake-title'>Claimable LP</div>\r\n                                        <div className='stake-value'>00000000</div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className='stake-body'>\r\n                                <div className='stake-input-wrap'>\r\n                                    <input className='stake-input' type='text' placeholder='Amount' onChange={(e) => this.changeInput(e)} value={inputEth} />\r\n                                    <div className='stake-type'></div>\r\n                                </div>\r\n                                \r\n\r\n                                <div className='stake-button' ></div>\r\n                                <div className='unstake-button' ></div>\r\n                              \r\n                            </div>\r\n                            <div className='stake-footer'>\r\n                                <div className='stake-wrap-more'>\r\n                                    <div className='stake-more'>Learn more <div>&#8250;</div></div>\r\n                                    <div className='stake-more'>Learn more <div>&#8250;</div></div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className='question-block'>\r\n                        <div className='question'>Any questions? Please head over to our telegram group</div>\r\n                        <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://t.me/hcorefinance'>\r\n                            <div className='button'></div>\r\n                        </a>\r\n                    </div>\r\n                </section>\r\n                {/* <main>\r\n                    <section className='vault'>\r\n                        <div className='description'>\r\n                            <h1>VAULT</h1>\r\n                            <h3>{`$HCORE TRANSFER FEES RECEIVED AND AVAILABLE NOW: ${liquidVault.feeBalance}`}</h3>\r\n                            <div className='description-item'>{`Sent ETH and receive $HCORE/ETH-UNI-V2-LP tokens claimable after ${liquidVault.stakeDuration} days`}</div>\r\n                            <br />\r\n                            <div className='description-item'>{`Current percentage of ETH: ${liquidVault.purchaseFee}%`}</div>\r\n                        </div>\r\n                        <div className='vault-button-wrap'>\r\n                             <div className='button-vault'>\r\n                                <h2>STAKE LP</h2>\r\n                                <div className='white-line'></div>\r\n                                <div className='hc-value'>{`YOUR POINTS: ${parseFloat(liquidVault.myPoints).toFixed(4)}`}</div>\r\n                                <div className='discriptrion-value'>{`MAX STAKE: ${liquidVault.maxStake}`}</div>\r\n                                <div className='button' onClick={() => this.changeModalStatus('stake')}>Stake</div>\r\n                                <div className='unstake' onClick={unStake}>Unstake</div>\r\n                            </div>\r\n                            <div className='button-vault'>\r\n                                <h2>SEND ETH</h2>\r\n                                <div className='white-line'></div>\r\n                                <div className='hc-value'>{`AVAILABLE $HCORE: ${liquidVault.balance}`}</div>\r\n                                <div className='button' onClick={() => this.changeModalStatus('send')}>Send ETH</div>\r\n                            </div>\r\n                            <div className='button-vault'>\r\n                                <h2>CLAIM LP</h2>\r\n                                <div className='white-line'></div>\r\n                                <div className='hc-value'>{`CLAIMABLE: ${liquidVault.tokens}`}</div>\r\n                                <div className='discriptrion-value'>{`NOT YET CLAIMABLE: ${liquidVault.notReadyTokens}`}</div>\r\n                                <div className='button' onClick={claim}>Claim LP</div>\r\n                            </div>\r\n                        </div>\r\n                    </section>\r\n                </main> */}\r\n                {modalIsOpen ? (\r\n                    <Modal confirmName='Send' name='vault' children={this.renderModalBody()} callback={modalType === 'send' ? this.sendEth : this.stakeLp} onClose={this.changeModalStatus} />\r\n                ) : null}\r\n            </React.Fragment>\r\n        )\r\n    }\r\n}\r\nconst mapStateToProps = state => {\r\n    return {\r\n        liquidVault: state.liquidVault\r\n    };\r\n};\r\n\r\nconst mapDispatchToProps = dispatch => {\r\n    return {\r\n        purchaseLP: (value, balance) => {\r\n            dispatch(purchaseLP(value, balance));\r\n        },\r\n        claim: () => {\r\n            dispatch(claim());\r\n        },\r\n        getLockedLP: () => {\r\n            dispatch(getLockedLP());\r\n        },\r\n        stake: (value) => {\r\n            dispatch(stake(value))\r\n        },\r\n        unStake: () => {\r\n            dispatch(unStake())\r\n        }\r\n    };\r\n};\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Vault);","D:\\Programming\\projects\\hardcore-frontend\\src\\constants\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\auth.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\liquidVault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\lpGame.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reportWebVitals.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\setupTests.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\shared\\Modal\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\utils\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\SpotTheBall\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\About\\index.jsx",["124"],{"ruleId":"125","severity":1,"message":"126","line":7,"column":5,"nodeType":"127","messageId":"128","endLine":9,"endColumn":6},{"ruleId":"129","severity":1,"message":"130","line":73,"column":17,"nodeType":"131","messageId":"132","endLine":73,"endColumn":22},{"ruleId":"129","severity":1,"message":"133","line":73,"column":24,"nodeType":"131","messageId":"132","endLine":73,"endColumn":35},{"ruleId":"129","severity":1,"message":"134","line":73,"column":37,"nodeType":"131","messageId":"132","endLine":73,"endColumn":44},{"ruleId":"125","severity":1,"message":"126","line":7,"column":5,"nodeType":"127","messageId":"128","endLine":9,"endColumn":6},"no-useless-constructor","Useless constructor.","MethodDefinition","noUselessConstructor","no-unused-vars","'claim' is assigned a value but never used.","Identifier","unusedVar","'liquidVault' is assigned a value but never used.","'unStake' is assigned a value but never used."]