ningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"91"},{"filePath":"92","messages":"93","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"94","messages":"95","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"96","messages":"97","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"98","messages":"99","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"100","messages":"101","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"102","messages":"103","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"104","messages":"105","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"106","messages":"107","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"108","messages":"109","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"110","messages":"111","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"112","messages":"113","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"114","messages":"115","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\Hcore.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\LiquidVault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\LPGenesisPoolGameAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\NFTFundAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\UniswapV2PairAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\auth.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\LPGenesisPoolGame.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\NFTFund.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\vault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\App.test.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\App.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Footer\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Header\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Home\\index.jsx",["116","117","118","119"],"import React, { PureComponent } from 'react';\r\nimport { TwitterOutlined, YoutubeOutlined, FacebookOutlined, GithubOutlined } from '@ant-design/icons';\r\nimport Game from '../SpotTheBall';\r\nimport './style.scss';\r\n\r\nexport default class Home extends PureComponent {\r\n    constructor() {\r\n        super()\r\n        this.state = {\r\n            time: 0\r\n        }\r\n    }\r\n\r\n    componentDidMount() {\r\n        this.setState({ time: 500000 })\r\n        this.interval = setInterval(() => {\r\n            let { time } = this.state;\r\n            time--;\r\n            this.setState({ time })\r\n        }, 1000);\r\n    }\r\n\r\n    componentWillUnmount() {\r\n        clearInterval(this.interval);\r\n    }\r\n\r\n    getExpiredTime(time) {\r\n        let days, hours, minutes, seconds;\r\n        if (time / 86400 >= 1) {\r\n            days = (time / 86400);\r\n            days = Math.trunc(days)\r\n        }\r\n        if (days) {\r\n            time -= days * 86400;\r\n        }\r\n        if (time / 3600 >= 1) {\r\n            hours = time / 3600;\r\n            hours = Math.trunc(hours)\r\n        }\r\n        if (hours) {\r\n            time -= hours * 3600;\r\n        }\r\n        if (time / 60 >= 1) {\r\n            minutes = time / 60;\r\n            minutes = Math.trunc(minutes)\r\n        }\r\n        if (minutes) {\r\n            time -= minutes * 60;\r\n        }\r\n        seconds = Math.round(time);\r\n        if ((!days && !hours && !minutes && !seconds) || time <= 0) {\r\n            return [0, 0, 0, 0]\r\n        }\r\n\r\n        return [days, hours, minutes, seconds]\r\n\r\n    }\r\n\r\n\r\n    render() {\r\n        const { time } = this.state;\r\n        const [days, hours, minutes, seconds] = this.getExpiredTime(time)\r\n        return (\r\n            <main className='home-page'>\r\n                <section>\r\n                    <div className='space'></div>\r\n                    <div className='background-image'>\r\n                        <div className='title'>Stake tokens to Win a Lambo</div>\r\n                    </div>\r\n\r\n                    <div className='content-wrap'>\r\n                        <div className='title-launch'>Launch</div>\r\n                        <div className='timer'>\r\n                            {`${days}D ${hours}:${minutes}:${seconds}`}\r\n                        </div>\r\n                        <div className='wrap-items'>\r\n                            <div className='item'>\r\n                                <div className='number'>1</div>\r\n                                <div className='title'>Swap DGVC on Uniswap</div>\r\n                                <div className='button swap'></div>\r\n                            </div>\r\n                            <div className='item'>\r\n                                <div className='number'>2</div>\r\n                                <div className='title'>Pool DGVC on Uniswap</div>\r\n                                <div className='button pool'></div>\r\n                            </div>\r\n                            <div className='item'>\r\n                                <div className='number'>3</div>\r\n                                <div className='title'>Wait for the #Alphadrop</div>\r\n                                <div className='button degen'></div>\r\n                            </div>\r\n                        </div>\r\n\r\n\r\n                    </div>\r\n\r\n                    <div className='stake-block'>\r\n                        <div className='title'>Stake to earn points</div>\r\n                        <div className='stake-panel'>\r\n                            <div className='stake'>\r\n                                <div className='stake-header'>\r\n                                    <div className='wrap-title first'>\r\n                                        <div className='stake-title'>Your $HCORE LP</div>\r\n                                        <div className='stake-value'>00000000</div>\r\n                                    </div>\r\n                                    <div className='wrap-title second'>\r\n                                        <div className='stake-title'>Point rate</div>\r\n                                        <div className='stake-value'>2 Points / day</div>\r\n                                    </div>\r\n                                    <div className='wrap-title third'>\r\n                                        <div className='stake-title'>Max stake</div>\r\n                                        <div className='stake-value'>2.02</div>\r\n                                    </div>\r\n                                    <div className='wrap-title fourth'>\r\n                                        <div className='stake-title'>Staked $HCORE LP</div>\r\n                                        <div className='stake-value'>0000000</div>\r\n                                    </div>\r\n                                </div>\r\n                                <div className='stake-body'>\r\n                                    <div className='stake-input-wrap'>\r\n                                        <input className='stake-input' type='text' placeholder='Amount' />\r\n                                        <div className='stake-type'>LP</div>\r\n                                    </div>\r\n                                    <div className='stake-button'></div>\r\n                                    <div className='unstake-button'></div>\r\n                                </div>\r\n                                <div className='stake-footer'>\r\n                                    <div className='stake-wrap-more'>\r\n                                        <div className='stake-more'>Learn more <div>&#8250;</div></div>\r\n                                        <div className='stake-more'>Learn more <div>&#8250;</div></div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className='stake-link'>Unstake from previous games <div>&#8250;</div></div>\r\n                    </div>\r\n                    <div className='game'>\r\n                        <div className='game-header'>\r\n                            Play Spot the Ball\r\n                        </div>\r\n                        <Game />\r\n                    </div>\r\n                    <div className='news-hardcore'>\r\n                        <div className='news-title'>New to HARDCORE?</div>\r\n                        <div className='wrap-items'>\r\n                            <div className='item'>\r\n                                <div className='label-item arrows'></div>\r\n                                <div className='title'>Swap $HCORE on Uniswap</div>\r\n                                <div className='button swap'></div>\r\n                            </div>\r\n                            <div className='item'>\r\n                                <div className='label-item money'></div>\r\n                                <div className='title'>Pool $HCORE on Uniswap</div>\r\n                                <div className='button pool'></div>\r\n                            </div>\r\n                            <div className='item'>\r\n                                <div className='label-item ask'></div>\r\n                                <div className='title'>How to play HARDCORE</div>\r\n                                <div className='button medium'></div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className='question-block'>\r\n                        <div className='question'>Any questions? Please head over to our telegram group</div>\r\n                        <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://t.me/hcorefinance'>\r\n                            <div className='button'></div>\r\n                        </a>\r\n                    </div>\r\n                </section>\r\n            </main>\r\n        )\r\n    }\r\n}","D:\\Programming\\projects\\hardcore-frontend\\src\\components\\NFT\\index.jsx",["120"],"import React, { PureComponent } from 'react';\r\nimport { getEthAndHcoreBalance, sellHcore} from '../../actions';\r\nimport { connect } from 'react-redux';\r\nimport './style.scss'\r\n\r\nclass NFT extends PureComponent {\r\n    constructor() {\r\n        super()\r\n    }\r\n\r\n    componentDidMount() {\r\n        const { getEthAndHcoreBalance } = this.props;\r\n        getEthAndHcoreBalance()\r\n    }\r\n\r\n    render() {\r\n        const { liquidVault: {ethBalance, hCoreBalance} } = this.props;\r\n\r\n        return (\r\n            <main>\r\n                <section className='NFT-page'>\r\n                    <h1>NFT</h1>\r\n                        <button onClick={() => this.props.sellHcore()}>Sell Hcore</button>\r\n                    <div className='wrap-nft'>\r\n                        <div className='score'>Hcore: { parseFloat(hCoreBalance).toFixed(3)}</div>\r\n                        <div className='score'>ETH: { parseFloat(ethBalance).toFixed(3)}</div>\r\n                    </div>\r\n                </section>\r\n            </main>\r\n        )\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => {\r\n    return {\r\n        liquidVault: state.liquidVault\r\n    };\r\n};\r\n\r\nconst mapDispatchToProps = dispatch => {\r\n    return {\r\n        getEthAndHcoreBalance: (value) => {\r\n            dispatch(getEthAndHcoreBalance(value));\r\n        },\r\n        sellHcore: () => {\r\n            dispatch(sellHcore());\r\n        }\r\n    };\r\n};\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(NFT);","D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Vault\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\constants\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\auth.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\liquidVault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\lpGame.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reportWebVitals.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\setupTests.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\shared\\Modal\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\utils\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\SpotTheBall\\index.jsx",[],{"ruleId":"121","severity":1,"message":"122","line":2,"column":10,"nodeType":"123","messageId":"124","endLine":2,"endColumn":25},{"ruleId":"121","severity":1,"message":"125","line":2,"column":27,"nodeType":"123","messageId":"124","endLine":2,"endColumn":42},{"ruleId":"121","severity":1,"message":"126","line":2,"column":44,"nodeType":"123","messageId":"124","endLine":2,"endColumn":60},{"ruleId":"121","severity":1,"message":"127","line":2,"column":62,"nodeType":"123","messageId":"124","endLine":2,"endColumn":76},{"ruleId":"128","severity":1,"message":"129","line":7,"column":5,"nodeType":"130","messageId":"131","endLine":9,"endColumn":6},"no-unused-vars","'TwitterOutlined' is defined but never used.","Identifier","unusedVar","'YoutubeOutlined' is defined but never used.","'FacebookOutlined' is defined but never used.","'GithubOutlined' is defined but never used.","no-useless-constructor","Useless constructor.","MethodDefinition","noUselessConstructor"]