ts\\hardcore-frontend\\src\\actions\\abi\\Hcore.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\LiquidVault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\LPGenesisPoolGameAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\NFTFundAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\UniswapV2PairAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\auth.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\LPGenesisPoolGame.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\NFTFund.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\vault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\App.test.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\App.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Footer\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Header\\index.jsx",["123"],"import React, { PureComponent, Fragment } from 'react'\r\n\r\nimport { NavLink } from \"react-router-dom\";\r\n\r\nimport Modal from '../../shared/Modal';\r\nimport { connect } from 'react-redux';\r\nimport { getAuth } from '../../actions'\r\nimport logo from '../../assets/images/logo.png'\r\n\r\nimport './style.scss'\r\n\r\nclass Header extends PureComponent {\r\n    constructor() {\r\n        super();\r\n        this.state = {\r\n            auth: false,\r\n            hamburgerIsOpen: false\r\n        }\r\n\r\n        this.toLogin = this.toLogin.bind(this)\r\n    }\r\n\r\n    componentDidMount() {\r\n        this.checkAuth()\r\n    }\r\n\r\n    checkAuth() {\r\n        const ethereum = window.ethereum\r\n        if (ethereum) {\r\n            if (ethereum.selectedAddress !== null) {\r\n                this.setState({ auth: ethereum.selectedAddress })\r\n                localStorage.auth = ethereum.selectedAddress;\r\n                this.props.getAuth();\r\n            } else {\r\n                const self = this\r\n                this.setState({ auth: localStorage.auth })\r\n                this.timeout = setTimeout(() => {\r\n                    const ethereum = window.ethereum;\r\n                    if (ethereum.selectedAddress !== null) {\r\n                        self.setState({ auth: ethereum.selectedAddress })\r\n                        localStorage.auth = ethereum.selectedAddress;\r\n                        this.props.getAuth();\r\n                    } else {\r\n                        localStorage.auth = '';\r\n                        self.setState({ auth: false })\r\n                    }\r\n                }, 400)\r\n            }\r\n        }\r\n    }\r\n\r\n    toLogin() {\r\n        this.props.getAuth();\r\n    }\r\n\r\n    render() {\r\n        const { auth, hamburgerIsOpen } = this.state;\r\n        const { authorized } = this.props;\r\n        const address = auth || authorized\r\n        return (\r\n            <Fragment>\r\n                <header className='header'>\r\n                    <img className='logo' src={logo} alt=\"\" />\r\n                    <nav className='navigation'>\r\n                        <NavLink to='/home' className='item'>HOME</NavLink>\r\n                        <NavLink to='/spot' className='item'>ABOUT</NavLink>\r\n                        <NavLink to='/vault' className='item'>VAULT</NavLink>\r\n                        <NavLink to='/nft' className='item'>GOVERNANCE</NavLink>\r\n                    </nav>\r\n                    {authorized || auth ? <div className='user-profile' onClick={() => { navigator.clipboard.writeText(authorized) }} >\r\n                        <div className='profile-logo'></div>\r\n                        <div className='user-address'>\r\n                            {`${address.slice(0, 6)}...${address.slice(-4)}`}\r\n                        </div>\r\n                    </div>\r\n                        :\r\n                        <div className='button' onClick={this.toLogin}>CONNECT WALLET</div>}\r\n                </header>\r\n                <header className='header mobile'>\r\n                    <img className='logo' src={logo} alt=\"\" />\r\n                    <div className={`checkbox ${hamburgerIsOpen ? 'active' : ''}`} onClick={() => { this.setState({ hamburgerIsOpen: !hamburgerIsOpen }) }}>\r\n                        <div class=\"hamburger hamburger1\">\r\n                            <span class=\"bar bar1\"></span>\r\n                            <span class=\"bar bar2\"></span>\r\n                            <span class=\"bar bar3\"></span>\r\n                            <span class=\"bar bar4\"></span>\r\n                        </div>\r\n                    </div>\r\n                    <div className={`mobile-nav-body ${hamburgerIsOpen ? 'active' : ''}`}>\r\n                        {authorized || auth ? <div className='user-profile' onClick={() => { navigator.clipboard.writeText(authorized) }} >\r\n                            <div className='profile-logo'></div>\r\n                            <div className='user-address'>\r\n                                {`${address.slice(0, 6)}...${address.slice(-4)}`}\r\n                            </div>\r\n                        </div>\r\n                            :\r\n                            <div className='button' onClick={this.toLogin}>CONNECT WALLET</div>}\r\n                        <nav className='navigation'>\r\n                            <NavLink to='/home' className='item'>HOME</NavLink>\r\n                            <NavLink to='/spot' className='item'>ABOUT</NavLink>\r\n                            <NavLink to='/vault' className='item'>VAULT</NavLink>\r\n                            <NavLink to='/nft' className='item'>GOVERNANCE</NavLink>\r\n                        </nav>\r\n                    </div>\r\n                </header>\r\n            </Fragment>\r\n        )\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => {\r\n    return {\r\n        authorized: state.auth.authorization\r\n    };\r\n};\r\n\r\nconst mapDispatchToProps = dispatch => {\r\n    return {\r\n        getAuth: () => {\r\n            dispatch(getAuth());\r\n        },\r\n\r\n    };\r\n};\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Header);","D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Home\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Vault\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\constants\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\auth.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\liquidVault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\lpGame.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reportWebVitals.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\setupTests.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\shared\\Modal\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\utils\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\SpotTheBall\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\About\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Governance\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\FeeDestAbi.js",[],{"ruleId":"124","severity":1,"message":"125","line":5,"column":8,"nodeType":"126","messageId":"127","endLine":5,"endColumn":13},"no-unused-vars","'Modal' is defined but never used.","Identifier","unusedVar"]