":"88","messages":"89","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"90","messages":"91","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"92"},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"95","messages":"96","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"97","messages":"98","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"99","messages":"100","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"101","messages":"102","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"103","messages":"104","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"105","messages":"106","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"107","messages":"108","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"109","messages":"110","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"111","messages":"112","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"113","messages":"114","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"115","messages":"116","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"117"},{"filePath":"118","messages":"119","errorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"120"},"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\Hcore.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\LiquidVault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\LPGenesisPoolGameAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\NFTFundAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\UniswapV2PairAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\auth.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\LPGenesisPoolGame.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\NFTFund.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\vault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\App.test.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\App.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Footer\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Header\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Home\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Vault\\index.jsx",["121","122","123"],"import React, { PureComponent } from 'react';\r\nimport { purchaseLP, claim, getLockedLP, stake, unStake } from '../../actions';\r\nimport Modal from '../../shared/Modal'\r\nimport { connect } from 'react-redux';\r\nimport './style.scss'\r\n\r\nclass Vault extends PureComponent {\r\n    constructor() {\r\n        super()\r\n        this.state = {\r\n            modalIsOpen: false,\r\n            inputEth: '',\r\n            modalType: ''\r\n        }\r\n\r\n        this.changeModalStatus = this.changeModalStatus.bind(this)\r\n        this.changeInput = this.changeInput.bind(this)\r\n        this.sendEth = this.sendEth.bind(this)\r\n        this.stakeLp = this.stakeLp.bind(this)\r\n    }\r\n\r\n    componentDidMount() {\r\n        const { getLockedLP } = this.props;\r\n        getLockedLP()\r\n    }\r\n\r\n    sendEth() {\r\n        const { purchaseLP, liquidVault } = this.props;\r\n        const { inputEth } = this.state;\r\n        this.setState({ modalIsOpen: false })\r\n        purchaseLP(inputEth, liquidVault.balance);\r\n    }\r\n\r\n    stakeLp() {\r\n        const { stake } = this.props;\r\n        const { inputEth } = this.state;\r\n        this.setState({ modalIsOpen: false })\r\n        stake(inputEth);\r\n    }\r\n\r\n    changeInput(e) {\r\n        this.setState({ inputEth: e.target.value });\r\n    }\r\n\r\n    changeModalStatus(type) {\r\n        let { modalIsOpen } = this.state;\r\n        this.setState({ modalIsOpen: !modalIsOpen, inputEth: '', modalType: type })\r\n    }\r\n\r\n    renderModalBody() {\r\n        const { inputEth, modalType } = this.state;\r\n        const { liquidVault } = this.props\r\n        if (modalType !== 'send') {\r\n            return (\r\n                <div className='wrap-modal'>\r\n                    <div className='title'>Enter Value</div>\r\n                    <input type='number' value={inputEth} onChange={this.changeInput}></input>\r\n                    <div>{`LP balance: ${liquidVault.myLpTokens}`}</div>\r\n                </div>\r\n            )\r\n        }\r\n        return (\r\n            <div className='wrap-modal'>\r\n                <div className='title'>Enter Value</div>\r\n                <input type='number' value={inputEth} onChange={this.changeInput}></input>\r\n                <div>{`Amount to send: ${parseFloat(inputEth - inputEth / 100 * liquidVault.purchaseFee).toFixed(4)}`}</div>\r\n                <div>{`ETH fee: ${(inputEth / 100 * liquidVault.purchaseFee).toFixed(2)}`}</div>\r\n            </div>\r\n        )\r\n    }\r\n\r\n    render() {\r\n        const { claim, liquidVault, unStake } = this.props;\r\n        const { modalIsOpen, modalType, inputEth } = this.state;\r\n        return (\r\n            <React.Fragment>\r\n                <section className='vault'>\r\n                    <div className='vault-page-title'>Vault</div>\r\n                    <div className='stake-panel'>\r\n                        <div className='header-panel'>\r\n                            <div className='header-text'>\r\n                                Send ETH. It is pooled with $HCORE. Your discounted LP is locked for a period.\r\n                            </div>\r\n                            <div>\r\n                                <div className='wrap-title second'>\r\n                                    <div className='header-text'>Available $HCORE</div>\r\n                                    <div className='stake-value'>0000000</div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className='stake'>\r\n                            <div className='stake-header'>\r\n                                <div className='wrap-title first'>\r\n                                    <div className='stake-title'>Max ETH</div>\r\n                                    <div className='stake-value'>00000000</div>\r\n                                </div>\r\n                                <div className='wrap-title first'>\r\n                                    <div className='stake-title'>Lock Period</div>\r\n                                    <div className='stake-value'>00000000</div>\r\n                                </div>\r\n                                <div className='wrap-title first'>\r\n                                    <div className='stake-title'>LP Discount</div>\r\n                                    <div className='stake-value'>00000000</div>\r\n                                </div>\r\n                                <div className='wrap-title first'>\r\n                                    <div className='stake-title'>LP Burn</div>\r\n                                    <div className='stake-value'>00000000</div>\r\n                                </div>\r\n                                <div className='second-block'>\r\n                                    <div className='wrap-title second'>\r\n                                        <div className='stake-title'>Not yet claimable LP</div>\r\n                                        <div className='stake-value'>00000000</div>\r\n                                    </div>\r\n                                    <div className='wrap-title second'>\r\n                                        <div className='stake-title'>Claimable LP</div>\r\n                                        <div className='stake-value'>00000000</div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className='stake-body'>\r\n                                <div className='stake-input-wrap'>\r\n                                    <input className='stake-input' type='text' placeholder='Amount' onChange={(e) => this.changeInput(e)} value={inputEth} />\r\n                                    <div className='stake-type'></div>\r\n                                </div>\r\n\r\n\r\n                                <div className='stake-button' ></div>\r\n                                <div className='unstake-button' ></div>\r\n\r\n                            </div>\r\n                            <div className='stake-footer'>\r\n                                <div className='stake-wrap-more'>\r\n                                    <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://medium.com/hcore/hcore-supply-rewards-1eedf2aad99c'>\r\n                                        <div className='stake-more'>Learn more <div>&#8250;</div></div>\r\n                                    </a>\r\n                                    <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://medium.com/hcore/hcore-supply-rewards-1eedf2aad99c'>\r\n                                        <div className='stake-more'>Learn more <div>&#8250;</div></div>\r\n                                    </a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className='question-block'>\r\n                        <div className='question'>Any questions? Please head over to our telegram group</div>\r\n                        <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://t.me/hcorefinance'>\r\n                            <div className='button'></div>\r\n                        </a>\r\n                    </div>\r\n                </section>\r\n                {/* <main>\r\n                    <section className='vault'>\r\n                        <div className='description'>\r\n                            <h1>VAULT</h1>\r\n                            <h3>{`$HCORE TRANSFER FEES RECEIVED AND AVAILABLE NOW: ${liquidVault.feeBalance}`}</h3>\r\n                            <div className='description-item'>{`Sent ETH and receive $HCORE/ETH-UNI-V2-LP tokens claimable after ${liquidVault.stakeDuration} days`}</div>\r\n                            <br />\r\n                            <div className='description-item'>{`Current percentage of ETH: ${liquidVault.purchaseFee}%`}</div>\r\n                        </div>\r\n                        <div className='vault-button-wrap'>\r\n                             <div className='button-vault'>\r\n                                <h2>STAKE LP</h2>\r\n                                <div className='white-line'></div>\r\n                                <div className='hc-value'>{`YOUR POINTS: ${parseFloat(liquidVault.myPoints).toFixed(4)}`}</div>\r\n                                <div className='discriptrion-value'>{`MAX STAKE: ${liquidVault.maxStake}`}</div>\r\n                                <div className='button' onClick={() => this.changeModalStatus('stake')}>Stake</div>\r\n                                <div className='unstake' onClick={unStake}>Unstake</div>\r\n                            </div>\r\n                            <div className='button-vault'>\r\n                                <h2>SEND ETH</h2>\r\n                                <div className='white-line'></div>\r\n                                <div className='hc-value'>{`AVAILABLE $HCORE: ${liquidVault.balance}`}</div>\r\n                                <div className='button' onClick={() => this.changeModalStatus('send')}>Send ETH</div>\r\n                            </div>\r\n                            <div className='button-vault'>\r\n                                <h2>CLAIM LP</h2>\r\n                                <div className='white-line'></div>\r\n                                <div className='hc-value'>{`CLAIMABLE: ${liquidVault.tokens}`}</div>\r\n                                <div className='discriptrion-value'>{`NOT YET CLAIMABLE: ${liquidVault.notReadyTokens}`}</div>\r\n                                <div className='button' onClick={claim}>Claim LP</div>\r\n                            </div>\r\n                        </div>\r\n                    </section>\r\n                </main> */}\r\n                {modalIsOpen ? (\r\n                    <Modal confirmName='Send' name='vault' children={this.renderModalBody()} callback={modalType === 'send' ? this.sendEth : this.stakeLp} onClose={this.changeModalStatus} />\r\n                ) : null}\r\n            </React.Fragment>\r\n        )\r\n    }\r\n}\r\nconst mapStateToProps = state => {\r\n    return {\r\n        liquidVault: state.liquidVault\r\n    };\r\n};\r\n\r\nconst mapDispatchToProps = dispatch => {\r\n    return {\r\n        purchaseLP: (value, balance) => {\r\n            dispatch(purchaseLP(value, balance));\r\n        },\r\n        claim: () => {\r\n            dispatch(claim());\r\n        },\r\n        getLockedLP: () => {\r\n            dispatch(getLockedLP());\r\n        },\r\n        stake: (value) => {\r\n            dispatch(stake(value))\r\n        },\r\n        unStake: () => {\r\n            dispatch(unStake())\r\n        }\r\n    };\r\n};\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(Vault);","D:\\Programming\\projects\\hardcore-frontend\\src\\constants\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\auth.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\liquidVault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\lpGame.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reportWebVitals.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\setupTests.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\shared\\Modal\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\utils\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\SpotTheBall\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\About\\index.jsx",["124"],"import React, { PureComponent } from 'react';\r\nimport { getEthAndHcoreBalance, sellHcore } from '../../actions';\r\nimport { connect } from 'react-redux';\r\nimport './style.scss'\r\n\r\nclass NFT extends PureComponent {\r\n    constructor() {\r\n        super()\r\n    }\r\n\r\n    componentDidMount() {\r\n        const { getEthAndHcoreBalance } = this.props;\r\n        getEthAndHcoreBalance()\r\n    }\r\n\r\n    render() {\r\n\r\n        return (\r\n            <main>\r\n                <section className='About-page'>\r\n                    <div className='about-page-header'>Tokenomics</div>\r\n                    <div className='tokenomics-panel'>\r\n                        <div className=\"block-1\">\r\n                            <div className='block-header'>DISTRIBUTION</div>\r\n                            <div className='block-row'>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">ALPHADROP</div>\r\n                                    <div className=\"block-item-value\">85%</div>\r\n                                </div>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">DEGEN.VC</div>\r\n                                    <div className=\"block-item-value\">15%</div>\r\n                                </div>\r\n                            </div>\r\n                            <div className='block-row'>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">Vault</div>\r\n                                    <div className=\"block-item-value\">15%</div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div className=\"block-2\">\r\n                            <div className='block-header'>$HCORE TOKEN</div>\r\n                            <div className='block-row'>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">Token Name</div>\r\n                                    <div className=\"block-item-value\">HCORE.FINANCE</div>\r\n                                </div>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">Total Supply</div>\r\n                                    <div className=\"block-item-value\">30,000 (capped)</div>\r\n                                </div>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">Burnable</div>\r\n                                    <div className=\"block-item-value\">Yes</div>\r\n                                </div>\r\n                            </div>\r\n                            <div className='block-row'>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">Token Symbol</div>\r\n                                    <div className=\"block-item-value\">HCORE</div>\r\n                                </div>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">Mintable</div>\r\n                                    <div className=\"block-item-value\">No</div>\r\n                                </div>\r\n                                <div className='block-item xl'>\r\n                                    <div className=\"block-item-header\">Token address</div>\r\n                                    <div className=\"block-item-value\">\r\n                                        <span>0x0b9D...2e14</span>\r\n                                        <span className='copy'>Copy</span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                        <div className=\"block-3\">\r\n                            <div className='block-header'>FEE ALLOCATION</div>\r\n                            <div className='block-row'>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">Vault</div>\r\n                                    <div className=\"block-item-value\">2%</div>\r\n                                </div>\r\n                            </div>\r\n                            <div className='block-row'>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">NFT Fund</div>\r\n                                    <div className=\"block-item-value\">3%</div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className='about-section'>\r\n\r\n                        <div className='header-about-section'>About HARDCORE</div>\r\n                        <div className=\"about-section-description\">\r\n                            <div>\r\n                                Breaking new ground, HARDCORE features a vault smart contract that receives 2% of the 5% Fee on Transfer (FOT) revenue and to which anyone can send ETH in\r\n                                order to receive UNI-V2 LP tokens (i.e. nearly 50% discounted), which are automatically locked for one month.\r\n                           </div>\r\n                            <div>\r\n                                What sets HARDCORE apart even more is that LP stakers can earn points with UNI-V2 LP that can be used to mine NFTs to win exotic cars.\r\n                                These rewards are acquired by the NFT fund smart contract using the other 3% of the fee revenue.\r\n                           </div>\r\n                            <div>\r\n                                The Degen.VC approach is to #alphadrop (airdrop) tokens to the DGVC LP and let the Uniswap market do the rest.\r\n                                This innovation has been covered in notable publications such as: The Coin Tribune; Altcoin Buzz, and Irish Tech News.\r\n                           </div>\r\n                        </div>\r\n                        <div className=\"button-about\"></div>\r\n                    </div>\r\n                    <div className=\"exotic-section\">\r\n                        <div className='clock-wrapper'>\r\n                            <div className='exotic-header'>Exotic Prizes</div>\r\n                            <div className='exotic-description'>HARDCORE spot the ball games will run consecutively.\r\n                            Players will need to unstake and stake again each time. Consider it like buying a ticket.\r\n                        Sometimes we will mix things up, for example, by offering a Rolex watch as the prize instead of a sports car.</div>\r\n                        </div>\r\n                    </div>\r\n                    <div className='team-section'>\r\n\r\n                        <div className='team-section-header'>Our Team</div>\r\n\r\n                        <div className='photos'>\r\n                            <div>\r\n                                <div className='photo fraser'></div>\r\n                                <div className='name'>Fraser Brown</div>\r\n                                <div className='description-photo'>Co-founder • Degen.VC</div>\r\n                                <div className='social'><a rel=\"noopener noreferrer\" target=\"_blank\" href='https://www.linkedin.com/in/fraserbrown-org/'>\r\n                                    <div className='icon twitter'></div>\r\n                                </a>\r\n                                    <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://www.linkedin.com/in/fraserbrown-org/'>\r\n                                        <b>In</b>\r\n                                    </a>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <div className='photo paul'></div>\r\n                                <div className='name'>Paul Scott</div>\r\n                                <div className='description-photo'>Co-founder • Degen.VC</div>\r\n                                <div className='social'><a rel=\"noopener noreferrer\" target=\"_blank\" href='https://twitter.com/paulscott005'>\r\n                                    <div className='icon twitter'></div>\r\n                                </a>\r\n                                    <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://www.linkedin.com/in/paulscott55/'>\r\n                                        <b>In</b>\r\n                                    </a>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <div className='photo justin'></div>\r\n                                <div className='name'>Justin Goro</div>\r\n                                <div className='description-photo'>Senior Dev • Degen.VC</div>\r\n                                <div className='social'><a rel=\"noopener noreferrer\" target=\"_blank\" href='https://github.com/gititGoro'>\r\n                                    <div className='icon github'></div>\r\n                                </a>\r\n                                </div>\r\n                            </div>\r\n                            <div>\r\n                                <div className='photo richard'></div>\r\n                                <div className='name'>Richard Parker</div>\r\n                                <div className='description-photo'>Community • Degen.VC</div>\r\n                                <div className='social'>\r\n                                    <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://twitter.com/upspwnage'>\r\n                                        <div className='icon twitter'></div>\r\n                                    </a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div className='question-block'>\r\n                        <div className='question'>Any questions? Please head over to our telegram group</div>\r\n                        <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://t.me/hcorefinance'>\r\n                            <div className='button'></div>\r\n                        </a>\r\n                    </div>\r\n                </section>\r\n            </main>\r\n        )\r\n    }\r\n}\r\n\r\nconst mapStateToProps = state => {\r\n    return {\r\n        liquidVault: state.liquidVault\r\n    };\r\n};\r\n\r\nconst mapDispatchToProps = dispatch => {\r\n    return {\r\n        getEthAndHcoreBalance: (value) => {\r\n            dispatch(getEthAndHcoreBalance(value));\r\n        },\r\n        sellHcore: () => {\r\n            dispatch(sellHcore());\r\n        }\r\n    };\r\n};\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(NFT);","D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Governance\\index.jsx",["125","126","127"],"import React, { PureComponent } from 'react';\r\nimport { getEthAndHcoreBalance, sellHcore } from '../../actions';\r\nimport { connect } from 'react-redux';\r\nimport './style.scss'\r\n\r\nclass NFT extends PureComponent {\r\n    constructor() {\r\n        super()\r\n    }\r\n\r\n    componentDidMount() {\r\n        const { getEthAndHcoreBalance } = this.props;\r\n        getEthAndHcoreBalance()\r\n    }\r\n\r\n    render() {\r\n        const { liquidVault: { ethBalance, hCoreBalance } } = this.props;\r\n\r\n        return (\r\n            <main>\r\n                <section className='Governance-page'>\r\n                    <div className=\"governance-header\">Governance</div>\r\n                    <div className='block-wrap'>\r\n\r\n\r\n                        <div className=\"block-1\">\r\n                            <div className=\"h-line\"></div>\r\n                            <div className='block-header'>$HCORE Fund</div>\r\n                            <div className='block-row'>\r\n                                <div className='block-item'>\r\n                                    <div className=\"block-item-header\">Fund $HCORE balance</div>\r\n                                    <div className=\"block-item-value\">00000000</div>\r\n                                </div>\r\n                                <div className='block-item'>\r\n              