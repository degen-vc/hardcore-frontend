ount":0,"fixableWarningCount":0},{"filePath":"88","messages":"89","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"90","messages":"91","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"92","messages":"93","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"94","messages":"95","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"96","messages":"97","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"98","messages":"99","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"100","messages":"101","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"102","messages":"103","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"104","messages":"105","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"106","messages":"107","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"108","messages":"109","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"110","messages":"111","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"112","messages":"113","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"114","messages":"115","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"116"},{"filePath":"117","messages":"118","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"119","messages":"120","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"121","messages":"122","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\Hcore.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\LiquidVault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\LPGenesisPoolGameAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\NFTFundAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\UniswapV2PairAbi.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\auth.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\LPGenesisPoolGame.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\NFTFund.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\vault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\App.test.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\App.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Footer\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Header\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Home\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Vault\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\constants\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\auth.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\liquidVault.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reducers\\lpGame.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\reportWebVitals.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\setupTests.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\shared\\Modal\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\utils\\index.js",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\SpotTheBall\\index.jsx",["123"],"import React, { PureComponent, } from 'react';\r\nimport { TweenMax } from 'gsap';\r\nimport { connect } from 'react-redux';\r\nimport { sendCoord, getAuth } from '../../actions';\r\nimport './style.scss';\r\n\r\nclass SpotTheBall extends PureComponent {\r\n    constructor() {\r\n        super()\r\n        this.state = {\r\n            x: 0,\r\n            y: 0,\r\n            selectedX: 0,\r\n            selectedY: 0,\r\n            pressButton: false,\r\n            startPlay: false,\r\n        }\r\n        this.myRef = React.createRef();\r\n        this.moveCircle = this.moveCircle.bind(this);\r\n        this.enterCircle = this.enterCircle.bind(this);\r\n        this.leaveCircle = this.leaveCircle.bind(this);\r\n        this.setPosition = this.setPosition.bind(this);\r\n    }\r\n    componentDidMount() {\r\n        this.myRef = this.myRef.current;\r\n        this.circle = this.myRef.lastChild.firstChild;\r\n        this.coordinateLine = this.myRef.lastChild.childNodes[1].firstChild;\r\n        this.offsetX = this.myRef.getBoundingClientRect().x - 0.5;\r\n        this.scale = 1.5;\r\n        this.leftPosition = true;\r\n        this.topPositin = true;\r\n    }\r\n\r\n    setPosition(e) {\r\n        const width = this.mobile ? 360 : 778\r\n        const height = this.mobile ? 260 : 556\r\n        const { clientX, clientY } = e;\r\n        let x = clientX - this.offsetX;\r\n        let y = clientY - this.offsetY;\r\n        if (y < height && x < width && x > 0) {\r\n            this.setState({ selectedX: Math.floor(this.mobile ? x * 2.155 : x), selectedY: Math.floor(this.mobile ? y * 2.155 : y) })\r\n            this.circle.style.left = `${x - 9}px`;\r\n            this.circle.style.top = `${y - 9}px`;\r\n        }\r\n    }\r\n\r\n    enterCircle() {\r\n        TweenMax.to(['#masker', '#imgZoom'], 0.3, { alpha: 1 });\r\n    }\r\n\r\n    leaveCircle() {\r\n        TweenMax.to(['#masker', '#imgZoom'], 0.3, { alpha: 0 });\r\n    }\r\n\r\n    moveCircle(e) {\r\n        if (!this.state.x) {\r\n            this.setState({ startPlay: !this.state.startPlay })\r\n        }\r\n        const width = this.mobile ? 360 : 778;\r\n        const height = this.mobile ? 260 : 556;\r\n        const { pressButton } = this.state;\r\n        const { clientX, clientY } = e;\r\n        const x = clientX - this.offsetX;\r\n        const y = clientY - this.offsetY;\r\n        if (x < 110) {\r\n            this.coordinateLine.style.left = '60px'\r\n            this.leftPosition = false;\r\n        } else if (!this.leftPosition) {\r\n            this.coordinateLine.style.left = '-70px'\r\n        }\r\n        if (y < 45) {\r\n            this.coordinateLine.style.top = '80px'\r\n            this.topPosition = false\r\n        } else if (!this.topPosition) {\r\n            this.coordinateLine.style.top = '-20px'\r\n        }\r\n        if (pressButton && x < width && y < height && x > 0) {\r\n            this.circle.style.left = `${x - 7}px`\r\n            this.circle.style.top = `${y - 7}px`;\r\n        }\r\n        if (x > 0 && y > 0 && x < width && y < height) {\r\n            this.setState({ x: Math.floor(this.mobile ? x * 2.155 : x), y: Math.floor(this.mobile ? y * 2.155 : y) })\r\n            TweenMax.to('.sight', 0.3, { x: e.clientX - this.offsetX - 41.5, y: e.clientY - this.offsetY - 41.5 });\r\n            TweenMax.to('#masker', 0.3, { attr: { cx: - this.offsetX + e.clientX, cy: -this.offsetY + e.clientY } });\r\n            TweenMax.to('#imgZoom', 0.3, { attr: { x: this.offsetX * (this.scale - 1) - e.clientX * (this.scale - 1), y: this.offsetY * (this.scale - 1) - e.clientY * (this.scale - 1) } });\r\n        }\r\n    }\r\n\r\n    renderPlayButton(balance, need, sendCoord, myBalanceHcore, myHcoreLp) {\r\n        const { selectedX, selectedY } = this.state;\r\n        if (balance !== 0 && balance < need) {\r\n            return <div className='not-authorized'>\r\n                <div className='auth-message'>Be patient. Your points balance is growing</div>\r\n                <div className=\"not-enough-button btn\">NOT ENOUGH POINTS</div>\r\n            </div>\r\n        } else if (!balance && !myBalanceHcore && !myHcoreLp) {\r\n            return <div className='not-authorized'>\r\n                <div className='auth-message'>HCORE LP tokens are needed to play</div>\r\n                <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://app.uniswap.org/#/add/ETH/0x740E9F161f4DF6D9027b35cB2AEc4A0137B5a36b'>\r\n                    <div className=\"get-tokens-button btn\" >GET TOKENS</div>\r\n                </a>\r\n            </div>\r\n        } else if (balance === 0 && (myBalanceHcore || myHcoreLp)) {\r\n            return <div className='not-authorized'>\r\n                <div className='auth-message'>Stake to earn points</div>\r\n                <div className=\"get-tokens-button btn\" onClick={() => { window.scrollTo(0, 1450) }}>STAKE</div>\r\n            </div>\r\n        } else {\r\n            return <div className='not-authorized'>\r\n                <div className={`auth-message ${selectedX ? '' : 'error'}`}>{`${selectedX ? 'Claim these coordinates as an NFT' : 'Choose your coordinate before play'}`}</div>\r\n                {selectedX ? <div className=\"play-button btn\" onClick={() => sendCoord(selectedX, selectedY)}>PLAY</div> : <div className=\"play-button btn\">PLAY</div>}\r\n            </div>\r\n        }\r\n    }\r\n\r\n    render() {\r\n\r\n        const { sendCoord, liquidVault: { myBalanceHcore, myHcoreLp }, balance: { balance, need } } = this.props;\r\n\r\n        const { selectedX, selectedY, x, y } = this.state;\r\n        if (window.innerWidth <= 420) {\r\n            this.mobile = true;\r\n        } else {\r\n            this.mobile = false;\r\n        }\r\n        if (this.myRef.current) {\r\n            this.circle = this.myRef.lastChild.firstChild;\r\n            this.coordinateLine = this.myRef.lastChild.childNodes[1].firstChild;\r\n            this.offsetX = this.myRef.getBoundingClientRect().x - 0.5;\r\n            this.offsetY = this.myRef.getBoundingClientRect().y - 0.5;\r\n        }\r\n        const width = this.mobile ? 360 : 780\r\n        const height = this.mobile ? 260 : 560\r\n        const { authorized, getAuth } = this.props;\r\n        return (\r\n            <div className=\"stb-wrapper\">\r\n                <div className={`wrap-plugin ${this.mobile ? '' : ''}`}>\r\n                    <div id=\"uvelichekniye-lupy\"\r\n                        ref={this.myRef}\r\n                        className={`grednsoledes ${this.mobile ? '' : ''}`}\r\n                        onMouseMove={this.moveCircle}\r\n                        onMouseLeave={this.leaveCircle}\r\n                        onMouseEnter={this.enterCircle}\r\n                        onClick={this.setPosition}\r\n                        onMouseDown={() => { this.setState({ pressButton: true }) }}\r\n                        onMouseUp={() => { this.setState({ pressButton: false }) }}\r\n                    >\r\n                        <img className=\"img grednsoledes\" src=\"https://lambo.hcore.finance/wp-content/uploads/2020/10/soccer-2-withoutball.jpg\" />\r\n\r\n                        <div className=\"svgWrapper\">\r\n                            <div className='cross'>\r\n                                <div className='line h'></div>\r\n                                <div className='line v'></div>\r\n                            </div>\r\n\r\n                            <div className='sight'>\r\n                                <div className='position'>{`X: ${x} Y: ${y}`}</div>\r\n                                <div className='cross'>\r\n                                    <div className='line h'></div>\r\n                                    <div className='line v'></div>\r\n                                </div>\r\n                                <div className='line horizontal l' />\r\n                                <div className='line horizontal r' />\r\n                                <div className='line vertical t' />\r\n                                <div className='line vertical b' />\r\n                            </div>\r\n                            <svg id=\"svgRoot\" width={width} height={height} version=\"1.1\" xmlns=\"https://www.w3.org/2000/svg\" link=\"https://www.w3.org/1999/xlink\">\r\n                                <defs id=\"defs\">\r\n                                    <mask id=\"m1\">\r\n                                        <circle id=\"masker\" cx=\"0\" cy=\"0\" r=\"40\" fill=\"#fff\" />\r\n                                    </mask>\r\n                                </defs>\r\n                                <image id=\"imgZoom\" mask=\"url(#m1)\" x=\"0\" y=\"0\" width={width * 1.5} height={height * 1.5} href=\"https://lambo.hcore.finance/wp-content/uploads/2020/10/soccer-2-withoutball.jpg\"></image>\r\n                            </svg>\r\n                        </div>\r\n\r\n                    </div>\r\n                </div>\r\n\r\n                <div className=\"stb-points\">\r\n                    <div className='game-title'>Choose your coordinate </div>\r\n                    <div className='coordinate-wrap'>\r\n                        <div className='coordinate'>\r\n                            {` X:${selectedX ? selectedX : '----'}`}\r\n                        </div>\r\n                        <div className='coordinate'>\r\n                            {` Y:${selectedY ? selectedY : '----'}`}\r\n                        </div>\r\n                    </div>\r\n                    <div className='game-points'>\r\n                        <div className='game-point-title'>Min points to play</div>\r\n                        <div className='game-point-value'>{parseFloat(need).toFixed(4)}</div>\r\n                    </div>\r\n                    <div className='game-points'>\r\n                        <div className='game-point-title'>Your points</div>\r\n                        <div className='game-point-value'>{parseFloat(balance).toFixed(4)}</div>\r\n                    </div>\r\n                    {!authorized ? (<div className='not-authorized'>\r\n                        <div className='auth-message'>Please connect to Metamask</div>\r\n                        <div className='button-connect' onClick={getAuth}></div>\r\n                        <a rel=\"noopener noreferrer\" target=\"_blank\" href='https://medium.com/hcore/hcore-supply-rewards-1eedf2aad99c'>\r\n                            <div className='stake-more'>Learn more <div>&#8250;</div></div>\r\n                        </a>\r\n                    </div>) : (\r\n                            this.renderPlayButton(balance, need, sendCoord, myBalanceHcore, myHcoreLp)\r\n                        )}\r\n                </div>\r\n            </div>\r\n        )\r\n    }\r\n}\r\nconst mapStateToProps = state => {\r\n    return {\r\n        balance: state.getBalance,\r\n        liquidVault: state.liquidVault,\r\n        authorized: state.auth.authorization\r\n    };\r\n};\r\n\r\nconst mapDispatchToProps = dispatch => {\r\n    return {\r\n        sendCoord: (x, y) => {\r\n            dispatch(sendCoord(x, y));\r\n        },\r\n        getAuth: () => {\r\n            dispatch(getAuth());\r\n        },\r\n    };\r\n};\r\n\r\nexport default connect(mapStateToProps, mapDispatchToProps)(SpotTheBall);","D:\\Programming\\projects\\hardcore-frontend\\src\\components\\About\\index.jsx",["124"],"D:\\Programming\\projects\\hardcore-frontend\\src\\components\\Governance\\index.jsx",[],"D:\\Programming\\projects\\hardcore-frontend\\src\\actions\\abi\\FeeDistAbi.js",[],{"ruleId":"125","severity":1,"message":"126","line":148,"column":25,"nodeType":"127","endLine":148,"endColumn":147},{"ruleId":"128","severity":1,"message":"129","line":14,"column":17,"nodeType":"130","messageId":"131","endLine":14,"endColumn":27},"jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement","no-unused-vars","'authorized' is assigned a value but never used.","Identifier","unusedVar"]